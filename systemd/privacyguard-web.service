# PrivacyGuard web dashboard service (Phase 5). Install to /etc/systemd/system/
# Enable 24/7 operation: sudo systemctl enable --now privacyguard-web
[Unit]
Description=PrivacyGuard Flask dashboard
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m flask --app privacyguard.web.app run --host 0.0.0.0 --port 5000
Restart=always
RestartSec=5
User=privacyguard

[Install]
WantedBy=multi-user.target
